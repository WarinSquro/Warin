# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Database
# Host port 15432 maps to container 5432 (avoids local Windows Postgres on 5432/5433)
DATABASE_URL="postgresql://admin:admin@127.0.0.1:15432/oneview?schema=public"

# API / Auth
API_PORT=3001
JWT_SECRET=warin-dev-jwt-secret-change-me
# Access token lifetime (seconds). Local default 8h; refresh tokens still rotate.
JWT_EXPIRES_SECONDS=28800
JWT_REFRESH_DAYS=7
HMAC_PEPPER=warin-dev-pepper-change-me
# Encrypts SMTP passwords stored in Settings (optional; falls back to HMAC_PEPPER)
# SMTP_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Storage
STORAGE_PROVIDER=filesystem
STORAGE_ROOT=./data/files

# Mail — env defaults for Compose/Mailpit; product email uses Settings → SMTP Settings (DB)
MAIL_DRY_RUN=false
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@warin.local
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
APP_PUBLIC_URL=http://127.0.0.1:5173
