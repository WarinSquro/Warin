{
  "name": "@oneview/mail",
  "version": "0.1.0",
  "description": "Enterprise mail facade: SMTP / BullMQ / RabbitMQ providers, templates, audit hooks — NestJS module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
