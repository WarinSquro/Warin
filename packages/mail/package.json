  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@types/nodemailer": "^6.4.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "~5.6.2"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "nodemailer": "^6.10.1"
  }
