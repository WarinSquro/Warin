# Ops Console paths — never point at WARIN PostgreSQL.
# This tool stores its own data under OPS_DATA_DIR (JSON files).

OPS_PORT=9191
OPS_BIND=127.0.0.1
OPS_SESSION_SECRET=change-me-ops-console-secret

# WARIN production layout on EC2 (defaults suit local repo checkout)
# OPS_WARIN_APP_DIR=/opt/warin/app
# OPS_BACKUP_ROOT=/opt/warin/backups
# OPS_SHARED_ENV=/opt/warin/shared/.env
# OPS_SHARED_WEB=/opt/warin/shared/web

# Public SPA API URL used when building WARIN web during deploy (never YOUR_DOMAIN)
# OPS_VITE_API_BASE_URL=http://127.0.0.1/api/v1

# Seed credentials (hashed into OPS_DATA_DIR on first boot; not shown in UI)
# OPS_ADMIN_USER=admin
# OPS_ADMIN_PASSWORD=   # set before first boot only
