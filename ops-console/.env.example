# Ops Console — never points at WARIN PostgreSQL.
# Own JSON store lives under OPS_DATA_DIR.

OPS_PORT=9191
OPS_BIND=127.0.0.1
OPS_SESSION_SECRET=change-me-ops-console-secret
# Set to 1 only when the browser reaches this service through HTTPS.
# OPS_COOKIE_SECURE=1

# --- Windows local (defaults when /opt/warin/app is absent) ---
# Leave unset: uses monorepo root + ./backups + ops-console/data

# --- Ubuntu EC2 (recommended) ---
# OPS_LAYOUT=ec2
# OPS_WARIN_APP_DIR=/opt/warin/app
# OPS_BACKUP_ROOT=/opt/warin/backups
# OPS_SHARED_ENV=/opt/warin/shared/.env
# OPS_SHARED_WEB=/opt/warin/shared/web
# OPS_DATA_DIR=/opt/warin/ops-console-data
# OPS_ENVIRONMENT_LABEL=PRODUCTION

# Public SPA API URL used when building WARIN web during deploy (never YOUR_DOMAIN)
# OPS_VITE_API_BASE_URL=http://YOUR_PUBLIC_IP/api/v1

# Optional binary overrides (rarely needed on Ubuntu)
# OPS_BASH=/bin/bash
# DOCKER_BIN=/usr/bin/docker
# OPS_TAR=/usr/bin/tar
# OPS_CURL=/usr/bin/curl

# Seed credentials (hashed into OPS_DATA_DIR; not shown in UI)
# OPS_ADMIN_USER=admin
# OPS_ADMIN_PASSWORD=91203
