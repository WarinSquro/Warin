{
  "name": "oneview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:reset:blank": "tsx prisma/seed.ts",
    "db:reset:migrate": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "packages:build": "npm run build --workspaces --if-present",
    "packages:build:security": "npm run build -w @oneview/security",
    "packages:build:redis": "npm run build -w @oneview/redis",
    "packages:build:storage": "npm run build -w @oneview/storage",
    "packages:build:mail": "npm run build -w @oneview/mail",
    "packages:build:auth": "npm run build -w @oneview/auth",
    "api:dev": "npm run start:dev -w @oneview/api",
    "api:build": "npm run build -w @oneview/api",
    "worker:dev": "npm run start:dev -w @oneview/worker",
    "worker:build": "npm run build -w @oneview/worker",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "exceljs": "^4.4.0",
    "prettier": "^3.4.2",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.1",
    "vitest": "^3.0.9"
  }
}
